    "expected": {
      "approvedRevision": 3,
      "blueprintId": "gbp_32cfc856acc170ca7a4d02b7",
      "digest": "543de9e0895733343b0521d82334a9e179b6bda086e95669335393124d4538e9",
      "roles": [
        {
          "description": "Your seven original pals—Mochi, Koko, Jiji, Tae, Nini, Rumi, and Sunny—need code-generated 2D pixel-art designs with distinct silhouettes, signature colors, accessories, outfits, and size variants, plus readable walk, pause, sit, sleep, cheer, group-dance, drag, and celebratory reaction states.",
          "id": "seven-pal-character-system",
          "label": "Seven distinct chibi pal character sets"
        },
        {
          "description": "Your lower-screen companion space needs a pastel purple pixel-art environment with clear walking, resting, and drag-and-drop zones, together with unlockable background variants that remain subordinate to the pals and visible app controls.",
          "id": "companion-play-area",
          "label": "Companion play area and unlockable backgrounds"
        },
        {
          "description": "Your pixel-style arcade needs distinct, immediately readable play surfaces for the category quiz, Memory Match, 3×3 sliding puzzle, 30-second Math Sprint, D/F/J/K Rhythm Tap, and five-letter word game, including score, timer, input, and result states.",
          "id": "arcade-minigame-boards",
          "label": "Six readable arcade mini-game boards"
        },
        {
          "description": "Your game needs compact code-generated pixel effects and poses for floating sleep z’s, encouragement, celebration, hearts, stars, streaks, achievements, buddy-job prompts, Done and Snooze feedback, quiet hours, focus mode, and Pomodoro status.",
          "id": "reactions-reminders-feedback",
          "label": "Pal reactions and reminder feedback"
        },
        {
          "description": "Your customization and shop systems need compatible code-generated pixel-art accessories and outfit overlays for every pal, with locked, purchasable, equipped, and unlocked states that preserve each pal’s identity.",
          "id": "wardrobe-accessory-system",
          "label": "Wardrobe, accessories, and outfit overlays"
        },
        {
          "description": "Your browser game needs a polished pastel pixel interface for pal configuration, active-pal controls, arcade navigation, progress, shop, reminders, volume, quiet hours, focus controls, and the 25/5 Pomodoro timer without native desktop or system-tray imagery.",
          "id": "pixel-app-interface",
          "label": "Unified pixel-style app interface"
        }
      ]
    },
    "overflowEvents": 0,
    "resolutions": {},
    "version": 1
  }
